    {
      "name": "Forecast Weather",
      "item": [
        {
          "name": "Forecast For A specific Hour",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "    pm.expect(pm.response.json().location.name).to.eql(\"Cairo\");\r",
                  "});\r",
                  "const todayDate = new Date().toISOString().split('T')[0];\r",
                  "\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "    pm.expect(pm.response.json().forecast).to.exist;\r",
                  "});\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "    pm.expect(pm.response.json().forecast.forecastday.length).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "    pm.expect(pm.response.json().forecast.forecastday[0].date).to.eql(todayDate);\r",
                  "});\r",
                  "pm.test(\"Body matches string\", function () {\r",
                  "    pm.expect(pm.response.json().forecast.forecastday[0].hour[0].time).to.contain(\"15:00\");\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
